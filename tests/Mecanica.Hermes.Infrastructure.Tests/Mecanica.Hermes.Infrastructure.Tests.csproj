<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- O SDK Web e estas duas flags são necessários para que o Cecil do coverlet consiga
             resolver tipos do shared framework (ex.: Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions)
             ao instrumentar Mecanica.Hermes.Infrastructure.dll. Sem isso, a cobertura desse
             assembly ficava 0% no Sonar (CecilAssemblyResolutionException). -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <PreserveCompilationContext>true</PreserveCompilationContext>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector"/>
        <PackageReference Include="FluentAssertions"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Moq"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MassTransit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Mecanica.Hermes.Infrastructure\Mecanica.Hermes.Infrastructure.csproj"/>
        <ProjectReference Include="..\..\src\Mecanica.Hermes.Application\Mecanica.Hermes.Application.csproj"/>
        <ProjectReference Include="..\..\src\Mecanica.Hermes.Domain\Mecanica.Hermes.Domain.csproj"/>
        <ProjectReference Include="..\Mecanica.Hermes.TestUtils\Mecanica.Hermes.TestUtils.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="FluentAssertions"/>
        <Using Include="Moq"/>
    </ItemGroup>

</Project>
